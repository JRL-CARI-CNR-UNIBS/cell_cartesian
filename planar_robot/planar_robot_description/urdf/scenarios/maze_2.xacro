<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="maze">

  <!-- === Shared properties === -->
  <xacro:property name="wall_height" value="0.1"/>
  <xacro:property name="wall_thickness" value="0.05"/>
  <xacro:property name="pillar_radius" value="0.05"/>
  <xacro:property name="pillar_height" value="0.1"/>
  <xacro:property name="x_offset" value="0.5"/>
  <xacro:property name="y_offset" value="0.5"/>
  <xacro:property name="box_height" value="0.1"/>


  <link name="maze_base_link"/>
  <joint name="maze_world_joint" type="fixed">
    <parent link="world"/>
    <child link="maze_base_link"/>
    <origin xyz="${x_offset} ${y_offset} 0" rpy="0 0 0"/>
  </joint>

  <!-- === Wall Macro === -->
  <xacro:macro name="maze_wall" params="name length x y yaw">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${wall_height / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="${length} ${wall_thickness} ${wall_height}"/>
        </geometry>
        <material name="gray">
          <color rgba="0.6 0.6 0.6 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${wall_height / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="${length} ${wall_thickness} ${wall_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="100000.0"/>
        <origin xyz="0 0 ${wall_height / 2}" rpy="0 0 0"/>
        <inertia ixx="1000" ixy="0" ixz="0" iyy="1000" iyz="0" izz="1000"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="maze_base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>

  <!-- === Pillar Macro === -->
  <xacro:macro name="maze_pillar" params="name x y">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${pillar_height / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${pillar_height}" radius="${pillar_radius}"/>
        </geometry>
        <material name="dark_gray">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${pillar_height / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${pillar_height}" radius="${pillar_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="100000.0"/>
        <origin xyz="0 0 ${pillar_height / 2}" rpy="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="maze_base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- === Parameterized Box Obstacle Macro === -->
  <xacro:macro name="maze_box" params="name x y size">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${box_height / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="${size} ${size} ${box_height}"/>
        </geometry>
        <material name="red">
          <color rgba="0.8 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${box_height / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="${size} ${size} ${box_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1000.0"/>
        <origin xyz="0 0 ${size / 2}" rpy="0 0 0"/>
        <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="maze_base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- === Outer square (1x1m boundary) === -->
  <xacro:maze_wall name="boundary_top"    length="1.0" x="0.0" y="0.5" yaw="0.0"/>
  <xacro:maze_wall name="boundary_bottom" length="1.0" x="0.0" y="-0.5" yaw="0.0"/>
  <xacro:maze_wall name="boundary_left"   length="1.0" x="-0.5" y="0.0" yaw="1.5708"/>
  <xacro:maze_wall name="boundary_right"  length="1.0" x="0.5" y="0.0" yaw="1.5708"/>

  <!-- === Eight Box Obstacles === -->
  <xacro:maze_box name="box_1" x="-0.25" y="-0.25" size="0.15"/>
  <xacro:maze_box name="box_2" x="-0.25" y="0.0" size="0.15"/>
  <xacro:maze_box name="box_3" x="-0.25" y="0.25" size="0.15"/>
  <xacro:maze_box name="box_4" x="0.0" y="-0.25" size="0.15"/>
  <xacro:maze_box name="box_5" x="0.0" y="0.0" size="0.15"/>
  <xacro:maze_box name="box_6" x="0.0" y="0.25" size="0.15"/>
  <xacro:maze_box name="box_7" x="0.25" y="0.0" size="0.15"/>
  <xacro:maze_box name="box_8" x="0.25" y="0.25" size="0.15"/>
  
</robot>
