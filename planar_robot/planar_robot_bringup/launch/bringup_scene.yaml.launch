launch:
- executable:
    cmd: 'cnr_param_server -p $(find-pkg-share planar_robot_bringup)/config/scene.yaml'

- include:
   file: "$(find-pkg-share planar_robot_bringup)/launch/bringup.launch.py"

- node:
    pkg: "cnr_scene_manager"
    exec: "cnr_scene_manager"
    output: "screen"
    param:
        - name: 'param_ns'
          value: '/cnr_scene_manager_test'